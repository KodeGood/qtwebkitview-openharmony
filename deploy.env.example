# Copy to deploy.env (ignored by git) and fill in the paths of this machine.

# WebKit for OpenHarmony dist dir, built with `build-webkit-ohos --release --qt <QT_OHOS>`.
WEBKIT_DIST=<webkit-tree>/WebKitBuild/OHOS/Release/dist
# Qt for OpenHarmony build dir.
QT_OHOS=<qt-ohos-build-dir>
# Host Qt build of the same Qt version.
QT_HOST_PATH=<qt-host-build-dir>
# OpenHarmony SDK root.
OHOS_SDK_ROOT=<ohos-sdk-root>
